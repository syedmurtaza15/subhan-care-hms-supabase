# --- Supabase (required) ---
# Find these in your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# --- Demo account credentials (used by the demo pill row on the login page) ---
VITE_DEMO_ADMIN_EMAIL=admin@subancare.com
VITE_DEMO_ADMIN_PASSWORD=Subhan@2026
VITE_DEMO_DOCTOR_EMAIL=doctor@subancare.com
VITE_DEMO_DOCTOR_PASSWORD=Subhan@2026
VITE_DEMO_RECEPTION_EMAIL=reception@subancare.com
VITE_DEMO_RECEPTION_PASSWORD=Subhan@2026
VITE_DEMO_PHARMACY_EMAIL=pharmacy@subancare.com
VITE_DEMO_PHARMACY_PASSWORD=Subhan@2026
VITE_DEMO_BILLING_EMAIL=billing@subancare.com
VITE_DEMO_BILLING_PASSWORD=Subhan@2026
VITE_DEMO_PATIENT_EMAIL=patient@subancare.com
VITE_DEMO_PATIENT_PASSWORD=Subhan@2026

# --- Service Role Key (one-time use only) ---
# Used ONLY for the seed-demo-users script. NEVER use a VITE_ prefix.
# Get it from Supabase Dashboard -> Project Settings -> API -> service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
